---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import Swatches from '../components/Swatches.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { services, serviceBySlug, seasonInfo, groupLabels, type Service } from '../data/services';
import { photoById, src, srcset } from '../data/photos';
import { reviews } from '../data/reviews';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props as { service: Service };
const related = s.related.map(serviceBySlug);
const pics = s.photos.map(photoById);
const review = reviews.find((r) => r.service && s.name.toLowerCase().includes(r.service.toLowerCase().split(' ')[0])) ?? null;
const schema = [{
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  description: s.metaDescription,
  areaServed: { '@type': 'City', name: 'Guelph' },
  provider: { '@id': `${site.url}/#business` },
  url: `${site.url}/${s.slug}`,
  ...(s.price ? { offers: { '@type': 'Offer', priceCurrency: 'CAD', price: s.price.from.replace('$', ''), description: `${s.price.from} ${s.price.unit}. ${s.price.note}` } } : {}),
}];
---
<Base title={s.metaTitle} description={s.metaDescription} image={s.photos[0]} schema={schema}>
  <PageHero
    title={`${s.name} in Guelph`}
    highlight="Guelph"
    lede={s.intro}
    crumbs={[{ label: 'Services', href: '/services' }, { label: s.name }]}
    cta
  />

  <section class="section">
    <div class="wrap svc">
      <div class="svc__main">
        <div class="svc__block">
          <h2>What is included</h2>
          <ul class="checklist">
            {s.included.map((i) => <li><Icon name="check" weight="bold" /><span>{i}</span></li>)}
          </ul>
        </div>

        {s.materials && (
          <div class="svc__block">
            <h2>{s.materials === 'mulch' ? 'Choose your mulch' : 'Choose your stone'}</h2>
            <p class="muted">{s.materials === 'mulch' ? 'Six colours to match your home and plants. Colour chips are a guide. Ask to see samples.' : 'Stone for raised beds, ground cover and drainage. Colour chips are a guide. Ask to see samples.'}</p>
            <Swatches kind={s.materials} />
          </div>
        )}

        <div class="svc__block svc__photos" data-reveal>
          <h2>Recent {s.short.toLowerCase()} work</h2>
          <div class:list={['svc__pics', `svc__pics--${Math.min(pics.length, 4)}`]}>
            {pics.map((p, i) => (
              <figure>
                <div class="photo"><img src={src(p.id, i === 0 ? 800 : 500, i === 0 ? 600 : 400)} srcset={srcset(p.id, i === 0 ? 800 : 500, i === 0 ? 600 : 400)} sizes="(max-width: 700px) 92vw, 480px" alt={p.alt} loading="lazy" /></div>
                <figcaption>{p.caption}</figcaption>
              </figure>
            ))}
          </div>
          <a href="/projects" class="text-link">See all projects <Icon name="arrow-right" /></a>
        </div>

        <div class="svc__block">
          <h2>Good to know</h2>
          <div class="svc__tips">
            {s.goodToKnow.map((t) => <p class="svc__tip"><Icon name="lightbulb" /><span>{t}</span></p>)}
          </div>
        </div>
      </div>

      <aside class="svc__aside">
        <div class="svc__card">
          {s.price ? (
            <>
              <p class="svc__kicker">Starting at</p>
              <p class="svc__price">{s.price.from}<span> {s.price.unit}</span></p>
              <p class="svc__note">{s.price.note}</p>
            </>
          ) : (
            <>
              <p class="svc__kicker">Pricing</p>
              <p class="svc__price svc__price--sm">Free, custom quote</p>
              <p class="svc__note">Send your address and a few photos and Josh will send a clear price.</p>
            </>
          )}
          <a href={`/contact?service=${s.slug}`} class="btn">Get a free quote<span class="btn__icon"><Icon name="arrow-right" weight="bold" /></span></a>
          <a href={site.phoneHref} class="svc__call"><Icon name="phone" />or call {site.phone}</a>
          <dl class="svc__facts">
            <div><dt>Best time</dt><dd>{s.seasons.map((x) => seasonInfo[x].name).join(', ')}</dd></div>
            <div><dt>Category</dt><dd>{groupLabels[s.group].name}</dd></div>
            <div><dt>Service area</dt><dd>Guelph and nearby</dd></div>
          </dl>
        </div>
        {s.addOn && (
          <div class="svc__addon">
            <p class="svc__kicker">Popular add-on</p>
            <h3>{s.addOn.name}</h3>
            <p>{s.addOn.text}</p>
            <p class="svc__addon-price">From {s.addOn.from} {s.addOn.unit}</p>
          </div>
        )}
        {review && (
          <figure class="svc__review">
            <span class="stars" role="img" aria-label="5 out of 5 stars">{[1,2,3,4,5].map(() => <Icon name="star" weight="fill" />)}</span>
            <blockquote>“{review.text}”</blockquote>
            <figcaption>{review.name}, {review.service}</figcaption>
          </figure>
        )}
      </aside>
    </div>
  </section>

  <section class="section section--mist" id="faq">
    <div class="wrap svc-faq">
      <div>
        <h2>{s.short} questions</h2>
        <p class="lede">Straight answers about {s.name.toLowerCase()} in Guelph.</p>
        <a href="/faq" class="text-link">All FAQs <Icon name="arrow-right" /></a>
      </div>
      <FaqList items={s.faqs} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="rel__title">Often booked together</h2>
      <ul class="rel">
        {related.map((r) => (
          <li>
            <a href={`/${r.slug}`} class="rel__row">
              <div class="photo rel__thumb"><img src={src(r.photos[0], 200, 200)} alt="" loading="lazy" width="200" height="200" /></div>
              <div class="rel__text">
                <h3>{r.name}</h3>
                <p>{r.card}</p>
              </div>
              <Icon name="arrow-right" class="rel__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title={`Ready for ${s.name.toLowerCase()}?`} picks={[s.slug, ...s.related]} />
</Base>

<style>
  .svc { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .svc__block + .svc__block { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .svc__block h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .svc__pics { display: grid; gap: 1rem; margin-bottom: 1.25rem; grid-template-columns: 1fr 1fr; }
  .svc__pics figure { margin: 0; }
  .svc__pics .photo { aspect-ratio: 5 / 4; }
  .svc__pics--3 figure:first-child, .svc__pics--4 figure:first-child { grid-column: 1 / -1; }
  .svc__pics--3 figure:first-child .photo, .svc__pics--4 figure:first-child .photo { aspect-ratio: 16 / 9; }
  .svc__pics--4 figure:first-child { grid-column: auto; }
  .svc__pics--4 figure:first-child .photo { aspect-ratio: 5 / 4; }
  .svc__pics figcaption { margin-top: 0.5rem; font-size: 0.92rem; font-weight: 600; }
  .svc__tips { display: grid; gap: 0.75rem; }
  .svc__tip { display: flex; gap: 0.85rem; margin: 0; padding: 1.1rem 1.25rem; border-radius: 16px; background: var(--lime-100); border: 1px solid rgba(63, 90, 54, 0.12); }
  .svc__tip :global(svg) { flex: none; width: 24px; height: 24px; color: var(--moss-600); }

  .svc__aside { position: sticky; top: calc(var(--header-h) + 20px); display: grid; gap: 1rem; }
  .svc__card { padding: 1.75rem; border-radius: 22px; background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow-md); display: grid; gap: 0.25rem; }
  .svc__card .btn { justify-content: space-between; margin-top: 1rem; }
  .svc__kicker { margin: 0; font-weight: 700; font-size: 0.9rem; color: var(--moss-500); }
  .svc__price { margin: 0; font-family: var(--font-display); font-stretch: 78%; font-weight: 800; font-size: 3.4rem; line-height: 1; color: var(--moss-900); }
  .svc__price span { font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--ink-soft); }
  .svc__price--sm { font-size: 2rem; font-stretch: 85%; }
  .svc__note { margin: 0.5rem 0 0; font-size: 0.95rem; color: var(--ink-soft); }
  .svc__call { display: inline-flex; justify-content: center; align-items: center; gap: 0.4rem; margin-top: 0.5rem; padding: 0.5rem; font-weight: 700; text-decoration: none; }
  .svc__call :global(svg) { width: 18px; height: 18px; color: var(--moss-600); }
  .svc__call:hover { text-decoration: underline; }
  .svc__facts { margin: 1rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); display: grid; gap: 0.6rem; }
  .svc__facts div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.95rem; }
  .svc__facts dt { color: var(--ink-soft); }
  .svc__facts dd { margin: 0; font-weight: 700; text-align: right; }
  .svc__addon { padding: 1.5rem; border-radius: 22px; background: var(--moss-600); color: var(--lime-100); }
  .svc__addon .svc__kicker { color: var(--lime-400); }
  .svc__addon h3 { color: var(--white); margin: 0.3rem 0 0.4rem; }
  .svc__addon p { font-size: 0.95rem; }
  .svc__addon-price { display: inline-block; margin: 0; padding: 0.25rem 0.7rem; border-radius: var(--r-pill); background: var(--lime-400); color: var(--moss-950); font-weight: 700; }
  .svc__review { margin: 0; padding: 1.5rem; border-radius: 22px; background: var(--lime-200); }
  .svc__review blockquote { margin: 0.6rem 0; font-family: var(--font-display); font-stretch: 92%; font-weight: 700; font-size: 1.15rem; line-height: 1.3; }
  .svc__review figcaption { font-size: 0.92rem; color: var(--ink-soft); }
  @media (max-width: 960px) {
    .svc { grid-template-columns: 1fr; }
    .svc__aside { position: static; grid-row: 1; }
  }

  .svc-faq { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 860px) { .svc-faq { grid-template-columns: 1fr; } }

  .rel__title { margin-bottom: 1.5rem; }
  .rel { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); border-radius: 22px; background: var(--mist); padding: 0.5rem; gap: 0.5rem; }
  .rel__row { display: grid; grid-template-columns: 76px 1fr auto; gap: 1rem; align-items: center; height: 100%; padding: 0.75rem; border-radius: 16px; text-decoration: none; transition: background-color 200ms ease; }
  .rel__thumb { width: 76px; height: 76px; border-radius: 12px; }
  .rel__text h3 { font-size: 1.12rem; margin: 0 0 0.15rem; }
  .rel__text p { margin: 0; font-size: 0.92rem; line-height: 1.4; color: var(--ink-soft); }
  .rel__row :global(.rel__arrow) { width: 18px; height: 18px; color: var(--moss-600); transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .rel__row:hover { background: var(--white); }
    .rel__row:hover :global(.rel__arrow) { transform: translateX(3px); }
  }
  @media (max-width: 960px) { .rel { grid-template-columns: 1fr; } }
</style>
