---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
---
<Base title="Page not found | Leaf It Alone" description="This page does not exist." noindex>
  <section class="nf stripes on-dark">
    <div class="wrap nf__inner">
      <h1>This page got mowed over</h1>
      <p class="lede">The link may be old or mistyped. Try one of these instead.</p>
      <ul class="nf__links">
        {services.slice(0, 6).map((s) => <li><a href={`/${s.slug}`}>{s.name}</a></li>)}
      </ul>
      <div class="btn-row">
        <a href="/" class="btn">Go to the home page<span class="btn__icon"><Icon name="arrow-right" weight="bold" /></span></a>
        <a href="/contact" class="btn btn--ghost">Get a free quote</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; min-height: 70vh; display: grid; place-items: center; padding-block: 5rem; text-align: center; color: var(--lime-100); }
  .nf::before { content: ''; position: absolute; inset: 0; background: rgba(21, 30, 18, 0.45); }
  .nf__inner { position: relative; display: grid; justify-items: center; }
  .nf h1 { color: var(--white); }
  .nf .lede { margin-inline: auto; }
  .nf__links { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.5rem; max-width: 36rem; margin: 1rem 0 2rem; }
  .nf__links a {
    display: inline-flex; align-items: center; min-height: 40px;
    color: var(--white); font-weight: 700; text-decoration: underline;
    text-decoration-color: rgba(206, 235, 76, 0.6); text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
  .nf__links a:hover { color: var(--lime-400); }
  .nf .btn-row { justify-content: center; }
</style>
