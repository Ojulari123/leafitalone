---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { generalFaqs } from '../data/faqs';
import { services } from '../data/services';

const all = generalFaqs.flatMap((g) => g.items);
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-').replace(/(^-|-$)/g, '');
---
<Base
  title="Lawn Care & Landscaping FAQ | Leaf It Alone, Guelph"
  description="Answers to common questions about Leaf It Alone: quotes and pricing, scheduling, rain days, yard waste, service areas and more."
>
  <PageHero title="Questions, answered" lede="Quick answers about quotes, pricing and how we work. Still wondering about something? Just ask Josh." crumbs={[{ label: 'FAQ' }]}>
    <div class="fsearch">
      <label for="faq-search" class="visually-hidden">Search the questions</label>
      <Icon name="magnifying-glass" />
      <input id="faq-search" type="search" placeholder="Search, e.g. rain, price, yard waste" autocomplete="off" data-faq-search />
    </div>
    <p class="fsearch__status" aria-live="polite" data-faq-status></p>
  </PageHero>

  <section class="section">
    <div class="wrap faqpage">
      <nav class="faqpage__toc" aria-label="FAQ topics">
        <p class="faqpage__label">Topics</p>
        <ul>
          {generalFaqs.map((g) => <li><a href={`#${slug(g.topic)}`}>{g.topic}</a></li>)}
          <li><a href="#services">By service</a></li>
        </ul>
        <div class="faqpage__ask">
          <p><strong>Still have a question?</strong></p>
          <a href={site.phoneHref} class="text-link"><Icon name="phone" />{site.phone}</a>
          <a href={`mailto:${site.email}`} class="text-link"><Icon name="envelope" />Email Josh</a>
        </div>
      </nav>
      <div class="faqpage__body">
        <p class="faqpage__empty" data-faq-empty hidden>No questions match that. Try another word, or <a href="/contact">ask Josh directly</a>.</p>
        {generalFaqs.map((g) => (
          <div id={slug(g.topic)} class="faqpage__group">
            <h2>{g.topic}</h2>
            <FaqList items={g.items} schema={false} />
          </div>
        ))}
        <div id="services" class="faqpage__group">
          <h2>By service</h2>
          <p class="muted">Each service page has its own questions and answers.</p>
          <ul class="faqpage__svc">
            {services.map((s) => <li><a class="chip" href={`/${s.slug}#faq`}><Icon name={s.icon} />{s.name}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
  <CtaBand />
</Base>

<style>
  .fsearch { position: relative; max-width: 34rem; margin-top: 1.75rem; }
  .fsearch :global(svg) { position: absolute; left: 1.1rem; top: 50%; width: 20px; height: 20px; margin-top: -10px; color: var(--moss-600); pointer-events: none; }
  .fsearch input {
    width: 100%; min-height: 56px; padding: 0.8rem 1rem 0.8rem 3rem; border-radius: var(--r-pill);
    border: 1.5px solid var(--line-input); background: var(--white); font-size: 1.05rem;
  }
  .fsearch input:focus { outline: 3px solid var(--moss-600); outline-offset: 2px; border-color: var(--moss-600); }
  .fsearch__status { margin: 0.6rem 0 0 1.1rem; min-height: 1.4em; font-size: 0.92rem; color: var(--ink-soft); }
  .faqpage__empty { padding: 1.25rem; border-radius: 16px; background: var(--lime-100); }
  .faqpage__empty a { color: var(--moss-600); font-weight: 700; }
  .faqpage { display: grid; grid-template-columns: 240px 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .faqpage__toc { position: sticky; top: calc(var(--header-h) + 24px); }
  .faqpage__label { font-weight: 700; font-size: 0.85rem; color: var(--moss-500); margin-bottom: 0.5rem; }
  .faqpage__toc ul { list-style: none; display: grid; gap: 0.2rem; }
  .faqpage__toc ul a { display: block; padding: 0.45rem 0.75rem; margin-left: -0.75rem; border-radius: 10px; font-weight: 600; text-decoration: none; }
  .faqpage__toc ul a:hover { background: var(--mist); }
  .faqpage__ask { display: grid; gap: 0.5rem; margin-top: 2rem; padding: 1.25rem; border-radius: 18px; background: var(--lime-100); }
  .faqpage__ask p { margin: 0; }
  .faqpage__group + .faqpage__group { margin-top: 3rem; }
  .faqpage__group h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .faqpage__svc { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 860px) { .faqpage { grid-template-columns: 1fr; } .faqpage__toc { position: static; } }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]')!;
  const status = document.querySelector<HTMLElement>('[data-faq-status]')!;
  const empty = document.querySelector<HTMLElement>('[data-faq-empty]')!;
  const groups = [...document.querySelectorAll<HTMLElement>('.faqpage__group')].filter((g) => g.id !== 'services');
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    // Match the start of words, so "rain" finds rain but not terrain
    const re = new RegExp(`\\b${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`, 'i');
    let shown = 0;
    groups.forEach((g) => {
      let inGroup = 0;
      g.querySelectorAll<HTMLDetailsElement>('details').forEach((d) => {
        const hit = !q || re.test(d.textContent!);
        d.hidden = !hit;
        d.open = !!q && hit;
        if (hit) inGroup++;
      });
      g.hidden = inGroup === 0;
      shown += inGroup;
    });
    empty.hidden = shown > 0;
    status.textContent = q ? `${shown} question${shown === 1 ? '' : 's'} found` : '';
  });
</script>
