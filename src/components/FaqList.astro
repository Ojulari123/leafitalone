---
import Icon from './Icon.astro';
import type { Faq } from '../data/services';
interface Props { items: Faq[]; schema?: boolean }
const { items, schema = true } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary><span>{f.q}</span><span class="faq__icon"><Icon name="plus" weight="bold" /></span></summary>
      <div class="faq__a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

<style>
  .faq { display: grid; gap: 0.6rem; }
  .faq__item { border-radius: 16px; background: var(--white); border: 1px solid var(--line); transition: border-color 200ms ease, box-shadow 200ms ease; }
  .faq__item[open] { border-color: rgba(63, 90, 54, 0.35); box-shadow: var(--shadow-sm); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1.1rem 1.25rem; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-stretch: 95%; font-weight: 700; font-size: 1.1rem; line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .faq__icon { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--mist); transition: transform 250ms var(--ease-out), background-color 200ms ease; }
  .faq__icon :global(svg) { width: 16px; height: 16px; }
  .faq__item[open] .faq__icon { transform: rotate(45deg); background: var(--lime-400); }
  .faq__a { padding: 0 1.25rem 1.1rem; color: var(--ink-soft); }
  .faq__a p { margin: 0; max-width: 65ch; }
  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a { animation: faqIn 260ms var(--ease-out); }
  }
  @keyframes faqIn { from { opacity: 0; transform: translateY(-4px); } }
</style>
