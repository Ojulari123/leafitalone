---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
interface Props { title?: string; text?: string; picks?: string[] }
const {
  title = 'Tell us about your yard',
  text = 'Pick what you need and we will send a free, no-obligation quote.',
  picks = ['lawn-mowing-guelph', 'fall-cleanups-guelph', 'spring-cleanup-guelph', 'mulch-installation-guelph', 'sod-installation-guelph', 'hedge-trimming-guelph'],
} = Astro.props;
const chosen = picks.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean);
---
<section class="cta stripes stripes--dark on-dark">
  <div class="wrap cta__inner">
    <div class="cta__copy">
      <h2>{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="cta__panel">
      <p class="cta__popular">
        Popular right now:{' '}
        {chosen.map((s, i) => (
          <>
            <a href={`/contact?service=${s.slug}`}>{s.short.toLowerCase()}</a>
            {s.price && <span class="cta__price"> from {s.price.from}</span>}
            {i < chosen.length - 2 ? ', ' : i === chosen.length - 2 ? ' and ' : '.'}
          </>
        ))}
      </p>
      <div class="btn-row">
        <a href="/contact" class="btn">Get a free quote<span class="btn__icon"><Icon name="arrow-right" weight="bold" /></span></a>
        <a href={site.phoneHref} class="btn btn--ghost"><Icon name="phone" />{site.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(4rem, 8vw, 6rem); color: var(--lime-100); }
  .cta__inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .cta h2 { color: var(--white); margin-bottom: 0.3em; }
  .cta__copy .lede { margin: 0; }
  .cta__panel { padding-left: clamp(0rem, 3vw, 2.5rem); border-left: 1px solid rgba(244, 250, 217, 0.16); }
  .cta__popular {
    margin: 0 0 2rem; max-width: 34ch;
    font-family: var(--font-display); font-stretch: 90%; font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.45; color: rgba(244, 250, 217, 0.8);
  }
  .cta__popular a {
    color: var(--white); font-weight: 750; text-decoration: underline;
    text-decoration-color: var(--lime-400); text-decoration-thickness: 2px; text-underline-offset: 5px;
    transition: color 160ms ease;
  }
  .cta__popular a:hover { color: var(--lime-400); }
  .cta__price { color: var(--lime-400); font-weight: 600; }
  @media (max-width: 860px) { .cta__panel { padding-left: 0; border-left: 0; } }
  @media (max-width: 860px) { .cta__inner { grid-template-columns: 1fr; } }
</style>
